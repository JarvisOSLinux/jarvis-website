---
import BaseLayout from "../layouts/BaseLayout.astro";
import { github } from "../lib/github";

// A dedicated checksum asset (<name>.sha512 / SHA512SUMS*) wins over a 128-hex
// digest in the release notes; null when neither exists.
async function findChecksum(data: any, isoName: string | null): Promise<string | null> {
  const SHA512_RE = /\b[0-9a-fA-F]{128}\b/;
  const sumAsset = data.assets?.find(
    (a: any) =>
      a.name.toLowerCase().endsWith(".sha512") || a.name.toUpperCase().startsWith("SHA512SUMS")
  );
  if (sumAsset) {
    try {
      const res = await fetch(sumAsset.browser_download_url, {
        signal: AbortSignal.timeout(10_000),
      });
      if (res.ok) {
        const lines = (await res.text()).trim().split("\n");
        const line = (isoName && lines.find((l) => l.includes(isoName))) || lines[0];
        const hex = line?.match(SHA512_RE)?.[0];
        if (hex) return hex;
      }
    } catch {
      /* fall through to the release notes */
    }
  }
  return data.body?.match(SHA512_RE)?.[0] ?? null;
}

const release = await github("repos/JarvisOSLinux/jarvisos/releases/latest");
const iso = release?.assets?.find((a: any) => a.name.endsWith(".iso"));
const checksum = release ? await findChecksum(release, iso?.name ?? null) : null;

// Per-OS buttons for the app, matched by filename, in the order the page showed them.
const appRelease = await github("repos/JarvisOSLinux/jarvis-app/releases/latest");
const appGroups: Array<[string, (n: string) => boolean]> = [
  ["Linux (rpm)", (n) => n.endsWith(".rpm")],
  ["Linux (deb)", (n) => n.endsWith(".deb")],
  ["Linux (AppImage)", (n) => n.endsWith(".AppImage")],
  ["macOS", (n) => n.endsWith(".dmg")],
  ["Windows", (n) => n.endsWith("-setup.exe") || n.endsWith(".msi")],
];
const appButtons = appGroups.flatMap(([label, match]) => {
  const asset = appRelease?.assets?.find((a: any) => match(a.name));
  return asset ? [{ label, href: asset.browser_download_url }] : [];
});

const downloadSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JARVIS OS",
  operatingSystem: "Linux",
  applicationCategory: "OperatingSystem",
  description:
    "Bootable Arch Linux ISO with local LLM inference, KDE Plasma 6, MCP orchestration layer, and the JARVIS AI assistant daemon. Purpose-built for LLM security research.",
  url: "https://jarvisoslinux.org",
  downloadUrl: "https://jarvisoslinux.org/download",
  author: {
    "@type": "Organization",
    name: "JarvisOSLinux",
    url: "https://github.com/JarvisOSLinux",
  },
});
---

<BaseLayout
  title="Download JARVIS"
  description="Get JARVIS three ways: the desktop app for Linux, macOS and Windows, the JARVIS daemon with its terminal UI, or JarvisOS built from source."
>
  <script slot="head" type="application/ld+json" set:html={downloadSchema} />
  <section class="section">
    <div class="container">
      <span class="section-label">Download</span>
      <h1 class="section-title">Get JARVIS</h1>
      <p class="dl-intro">
        Three ways in. Install the <strong>JARVIS daemon</strong> on the Linux you already run
        and use its terminal UI, add the <strong>desktop app</strong> for a window, or build{" "}
        <strong>JarvisOS</strong>, the whole system preconfigured on Arch Linux. The app, the
        terminal and your phone all talk to the same daemon.
      </p>
    </div>
  </section>

  <!-- JarvisOS — latest ISO release (read from GitHub when the site is built) -->
  <section class="section" style="padding-top: 0;" id="jarvisos">
    <div class="container">
      <span class="section-label">JarvisOS</span>
      <h2 class="section-title">The full system</h2>
      <div class="card release-card glow-border" id="latest-release">
        <div class="release-header">
          <span class="tag tag-medium">Latest Release</span>
          <span class="mono text-muted">
            {release
              ? new Date(release.published_at).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })
              : "No ISO found"}
          </span>
        </div>
        <h2 style="margin-top: var(--space-md);">
          {release ? release.name || release.tag_name : "Build it from source for now"}
        </h2>
        {release ? (
          <p style="margin-top: var(--space-sm);">{release.body?.slice(0, 300) || "No description."}</p>
        ) : (
          <p style="margin-top: var(--space-sm);">
            No prebuilt ISO was found when this page was built. The pipeline under{" "}
            <a href="#build">Build from source</a> produces one; published ISOs appear on{" "}
            <a href="https://github.com/JarvisOSLinux/jarvisos/releases">GitHub releases</a>.
          </p>
        )}
        {release && (
          <div class="release-actions" style="margin-top: var(--space-xl);">
            {iso && (
              <a href={iso.browser_download_url} class="btn btn-primary">Download ISO</a>
            )}
            <a href={release.html_url} class="btn btn-outline">Release notes &nearr;</a>
          </div>
        )}
        {checksum && (
          <div style="margin-top: var(--space-xl);">
            <span class="section-label">SHA-512 Checksum</span>
            <pre class="mono checksum-pre"><code>{checksum}</code></pre>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Jarvis App — desktop app releases (read from GitHub when the site is built) -->
  <section class="section" id="app">
    <div class="container">
      <span class="section-label">Jarvis App</span>
      <h2 class="section-title">The desktop app</h2>
      <div class="card release-card glow-border">
        <div class="release-header">
          <span class="tag tag-medium">Latest Release</span>
          <span class="mono text-muted">
            {appRelease ? appRelease.name || appRelease.tag_name : "see GitHub"}
          </span>
        </div>
        <p style="margin-top: var(--space-md);">
          A desktop window for the JARVIS daemon: chat, sessions, permission requests with
          per-task approval, settings, providers and desktop widgets. It needs the daemon
          (below) or JarvisOS.
        </p>
        <div class="release-actions" style="margin-top: var(--space-xl);">
          {appButtons.map((b) => (
            <a href={b.href} class="btn btn-primary">{b.label}</a>
          ))}
          <a href="https://github.com/JarvisOSLinux/jarvis-app/releases/latest" class="btn btn-outline"
             target="_blank" rel="noopener noreferrer">All downloads &nearr;</a>
        </div>
        <p class="text-muted" style="margin-top: var(--space-lg); font-size: 0.9rem;">
          Builds are currently unsigned: Windows SmartScreen warns (&ldquo;More info &rarr;
          Run anyway&rdquo;) and macOS needs right-click &rarr; Open on first launch. The
          macOS build is Apple silicon only for now. Linux needs WebKitGTK&nbsp;4.1.
        </p>
      </div>
    </div>
  </section>

  <!-- Jarvis CLI/TUI — the daemon itself -->
  <section class="section" id="daemon">
    <div class="container">
      <span class="section-label">The daemon</span>
      <h2 class="section-title">JARVIS on the Linux you run</h2>
      <div class="card release-card glow-border">
        <p>
          Project-JARVIS is the brain: the model, the confirmation gate, finding and running
          tools, voice, the terminal UI and the phone gateway. Install it from source, then
          give it a model, local or any OpenAI-compatible API:
        </p>
        <pre class="mono install-cmd" style="margin-top: var(--space-md);"><code>git clone https://github.com/JarvisOSLinux/Project-JARVIS.git
cd Project-JARVIS && pip install -e ".[tui]"

# a model on this machine (needs llama.cpp's llama-server) ...
jarvis providers add --type llamacpp --model Qwen/Qwen3-4B-GGUF:Q4_K_M
# ... or any OpenAI-compatible API
jarvis providers add --type api --model &lt;model&gt; --url &lt;api url&gt; --key &lt;key&gt;

jarvis tui</code></pre>
        <p class="text-muted" style="margin-top: var(--space-md); font-size: 0.9rem;">
          PyPI's <code>project-jarvis</code> is the last release, 2.0.0 from August 2026. It
          predates local models through llama.cpp, phone control and the root-command guards,
          so install from source for what this site describes.
        </p>
        <div class="release-actions" style="margin-top: var(--space-xl);">
          <a href="https://github.com/JarvisOSLinux/Project-JARVIS" class="btn btn-primary"
             target="_blank" rel="noopener noreferrer">Source &amp; docs &nearr;</a>
          <a href="https://pypi.org/project/project-jarvis/" class="btn btn-outline"
             target="_blank" rel="noopener noreferrer">PyPI (2.0.0) &nearr;</a>
        </div>
        <p class="text-muted" style="margin-top: var(--space-lg); font-size: 0.9rem;">
          Linux is the reference platform. Windows and macOS are supported in beta
          (Python 3.11&ndash;3.13 recommended); tool servers from the MCP registry are
          mostly Linux-only today.
        </p>
      </div>
      <div class="card" style="margin-top: var(--space-lg);">
        <h3>Sidecars</h3>
        <p>
          The daemon orchestrates three small Rust binaries. They install with JarvisOS and
          build with <code>cargo</code>; prebuilt per-OS binaries live on each repo&rsquo;s
          releases page:
          <a href="https://github.com/JarvisOSLinux/dispatch/releases" target="_blank" rel="noopener noreferrer">dispatch</a> (task orchestrator) &middot;
          <a href="https://github.com/JarvisOSLinux/dmcp/releases" target="_blank" rel="noopener noreferrer">dmcp</a> (MCP server manager) &middot;
          <a href="https://github.com/JarvisOSLinux/contextor/releases" target="_blank" rel="noopener noreferrer">contextor</a> (long-term memory).
        </p>
      </div>
    </div>
  </section>

  <!-- Install instructions -->
  <section class="section">
    <div class="container">
      <span class="section-label">Getting Started</span>
      <h2 class="section-title">Installing JarvisOS</h2>
      <div class="grid-2">
        <div class="card">
          <h3>1. Boot from USB</h3>
          <p>
            Flash the ISO to a USB drive using <code>dd</code>, Ventoy, or Balena Etcher.
            Boot from the USB and you'll land in the live environment.
          </p>
          <pre class="mono install-cmd"><code>sudo dd if=jarvisos-*.iso of=/dev/sdX bs=4M status=progress</code></pre>
        </div>
        <div class="card">
          <h3>2. Live Environment</h3>
          <p>
            The live session gives you a fully functional JARVIS OS with KDE Plasma 6.
            Test the AI features, explore the system, and run the <code>jarvis</code> CLI.
          </p>
        </div>
        <div class="card">
          <h3>3. Install to Disk</h3>
          <p>
            Launch the Calamares installer from the desktop for a guided installation
            to your hard drive — automatic partitioning, user setup, and bootloader
            configuration included.
          </p>
        </div>
        <div class="card">
          <h3>4. Virtual Machine</h3>
          <p>
            JARVIS OS runs well in VirtualBox or QEMU/KVM. Allocate at least 4 GB RAM
            and 20 GB disk for comfortable usage with local LLM inference.
          </p>
          <pre class="mono install-cmd"><code>qemu-system-x86_64 -m 4G -smp 4 -cdrom jarvisos-*.iso</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Mirrors / source -->
  <section class="section">
    <div class="container">
      <span class="section-label" id="build">Source</span>
      <h2 class="section-title">Build from source</h2>
      <div class="card">
        <p>
          JARVIS OS is fully open source. Clone the build system and run the nine-script
          pipeline to produce your own ISO from scratch.
        </p>
        <pre class="mono install-cmd" style="margin-top: var(--space-md);"><code>git clone https://github.com/JarvisOSLinux/jarvisos.git
cd jarvisos
sudo ./01-*.sh   # begin the build pipeline</code></pre>
        <a
          href="https://github.com/JarvisOSLinux/jarvisos"
          class="btn btn-outline"
          style="margin-top: var(--space-lg);"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub &nearr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dl-intro {
    font-size: 1.05rem;
    max-width: 640px;
  }

  .release-card {
    padding: var(--space-2xl);
  }

  .release-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .release-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .checksum-pre {
    margin-top: var(--space-sm);
    padding: var(--space-md);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.75rem;
    overflow-x: auto;
    word-break: break-all;
  }

  .install-cmd {
    margin-top: var(--space-md);
    padding: var(--space-md);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.8rem;
    overflow-x: auto;
  }
</style>
