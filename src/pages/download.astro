---
import BaseLayout from "../layouts/BaseLayout.astro";
import { github } from "../lib/github";

const downloadSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JARVIS",
  operatingSystem: "Linux",
  applicationCategory: "UtilitiesApplication",
  description:
    "Hand AI your work, not your data: an AI that does your work on your own Linux computer, with a model that runs there too, and asks before it changes anything. Free and open source.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  url: "https://jarvisoslinux.org/download",
  author: {
    "@type": "Organization",
    name: "JarvisOSLinux",
    url: "https://github.com/JarvisOSLinux",
  },
});

const gh = "https://github.com/JarvisOSLinux";

// Releases are read from GitHub when the site is built (src/lib/github.ts), so
// a new release shows here after the next build and deploy.

// Desktop app: one button per platform from the latest release's assets.
const app = await github("repos/JarvisOSLinux/jarvis-app/releases/latest");
const appGroups: Array<[string, (n: string) => boolean]> = [
  ["Linux (AppImage)", (n) => n.endsWith(".AppImage")],
  ["Linux (deb)", (n) => n.endsWith(".deb")],
  ["Linux (rpm)", (n) => n.endsWith(".rpm")],
  ["macOS", (n) => n.endsWith(".dmg")],
  ["Windows", (n) => n.endsWith("-setup.exe") || n.endsWith(".msi")],
];
const appButtons = appGroups.flatMap(([label, match]) => {
  const asset = app?.assets?.find((a: any) => match(a.name));
  return asset ? [{ label, href: asset.browser_download_url }] : [];
});

// A dedicated checksum asset (<name>.sha512 / SHA512SUMS*) wins over a 128-hex
// digest in the release notes; null when neither exists.
async function findChecksum(data: any, isoName: string): Promise<string | null> {
  const SHA512_RE = /\b[0-9a-fA-F]{128}\b/;
  const sumAsset = data.assets?.find(
    (a: any) =>
      a.name.toLowerCase().endsWith(".sha512") || a.name.toUpperCase().startsWith("SHA512SUMS")
  );
  if (sumAsset) {
    try {
      const res = await fetch(sumAsset.browser_download_url, {
        signal: AbortSignal.timeout(10_000),
      });
      if (res.ok) {
        const lines = (await res.text()).trim().split("\n");
        const line = lines.find((l) => l.includes(isoName)) || lines[0];
        const hex = line?.match(SHA512_RE)?.[0];
        if (hex) return hex;
      }
    } catch {
      /* fall through to the release notes */
    }
  }
  return data.body?.match(SHA512_RE)?.[0] ?? null;
}

// JarvisOS: the card says there is no ISO until a release carries one.
const os = await github("repos/JarvisOSLinux/jarvisos/releases/latest");
const iso = os?.assets?.find((a: any) => a.name.endsWith(".iso")) ?? null;
const checksum = iso ? await findChecksum(os, iso.name) : null;
const released = iso
  ? new Date(os.published_at).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<BaseLayout
  title="Get JARVIS"
  description="Install JARVIS on the Linux you already have in four steps: its helpers, JARVIS itself, a model on your computer (llama.cpp) or any OpenAI-compatible API, then ask. Plus the desktop app, phone access and JarvisOS."
>
  <script slot="head" type="application/ld+json" set:html={downloadSchema} />

  <section class="section dl-hero">
    <div class="container">
      <span class="section-label">Get JARVIS</span>
      <h1 class="section-title">Four steps to your first ask.</h1>
      <p class="section-lede">
        JARVIS runs on the Linux you already have. Paste these into a terminal: they install
        JARVIS, give it a model and open a chat. Free, open source, and no account to make.
      </p>
      <p class="dl-needs mono">
        You need: Linux · Python 3.10 or newer · git and curl
      </p>
      <p class="dl-jump">
        Rather have a window? <a href="#app">The desktop app</a>. A whole system with JARVIS
        built in? <a href="#jarvisos">JarvisOS</a>.
      </p>
    </div>
  </section>

  <section class="section section--flush-top" id="daemon">
    <div class="container">
      <ol class="steps">
        <li class="step">
          <div class="step-copy">
            <span class="step-n mono">1</span>
            <h2>Its three helpers</h2>
            <p>
              JARVIS hands the work to three small programs: <strong>dispatch</strong> runs
              tools side by side, <strong>dmcp</strong> installs and starts them, and{" "}
              <strong>contextor</strong> remembers. This puts them in{" "}
              <code>~/.local/bin</code>.
            </p>
            <p class="step-note">
              Not on an x86-64 PC? Build them with Rust instead:{" "}
              <code>cargo install --git {gh}/dispatch</code>, then the same for dmcp and
              contextor.
            </p>
          </div>
          <div class="code" data-code>
            <div class="code-bar mono"><span>Terminal</span><button class="code-copy" type="button">Copy</button></div>
            <pre><code>{`mkdir -p ~/.local/bin
for t in dispatch dmcp contextor; do
  curl -fL -o ~/.local/bin/$t \\
    ${gh}/$t/releases/latest/download/$t-linux-x86_64
  chmod +x ~/.local/bin/$t
done`}</code></pre>
          </div>
        </li>

        <li class="step">
          <div class="step-copy">
            <span class="step-n mono">2</span>
            <h2>JARVIS itself</h2>
            <p>
              From source, in its own Python environment, with the terminal UI. The last line
              lets you type <code>jarvis</code> from anywhere.
            </p>
            <p class="step-note">
              Shell says <code>jarvis: command not found</code>? Add{" "}
              <code>export PATH="$HOME/.local/bin:$PATH"</code> to <code>~/.bashrc</code> and
              open a new terminal. Why not <code>pip install project-jarvis</code>? PyPI has
              2.0.0 from August, before local models, phone access and the root-command guards.
            </p>
          </div>
          <div class="code" data-code>
            <div class="code-bar mono"><span>Terminal</span><button class="code-copy" type="button">Copy</button></div>
            <pre><code>{`git clone ${gh}/Project-JARVIS.git
cd Project-JARVIS
python -m venv .venv
.venv/bin/pip install -e ".[tui]"
ln -sf "$PWD/.venv/bin/jarvis" ~/.local/bin/jarvis`}</code></pre>
          </div>
        </li>

        <li class="step">
          <div class="step-copy">
            <span class="step-n mono">3</span>
            <h2>A model on your computer</h2>
            <p>
              The private way, and the free one: a model that runs on your computer through
              llama.cpp, so nothing you say leaves it. JARVIS downloads it, about 2.5&nbsp;GB, the
              first time it starts.
            </p>
            <p class="step-note">
              Prefer a bigger hosted model? Any OpenAI-compatible API works with your own key. Then
              what you ask goes to that provider. <a href="/docs/how-jarvis-protects-you">What stays on your computer →</a>
            </p>
            <p class="step-note">
              Keep llama.cpp even with a hosted model. JARVIS runs a small local model with it
              to find tools and search its memory; without it, it finds tools by keyword.
            </p>
          </div>
          <div class="code" data-code>
            <div class="code-bar mono"><span>Terminal</span><button class="code-copy" type="button">Copy</button></div>
            <pre><code>{`sudo pacman -S llama-cpp   # Arch; elsewhere, llama.cpp's own builds
jarvis providers add --type llamacpp --model Qwen/Qwen3-4B-GGUF:Q4_K_M

# or a hosted model
jarvis providers add --type api --model <model> --url <api url> --key <key>`}</code></pre>
          </div>
        </li>

        <li class="step">
          <div class="step-copy">
            <span class="step-n mono">4</span>
            <h2>Ask</h2>
            <p>
              Type what you want. When JARVIS needs a tool it doesn't have yet, it finds one in
              the <a href="/servers">registry</a> and installs it. Anything risky waits for
              your OK.
            </p>
          </div>
          <div class="code" data-code>
            <div class="code-bar mono"><span>Terminal</span><button class="code-copy" type="button">Copy</button></div>
            <pre><code>jarvis tui</code></pre>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--band" id="app">
    <div class="container more-ways">
      <div class="more-way">
        <span class="section-label">A window</span>
        <h2>The desktop app</h2>
        <p>
          Chat, approvals, sessions, settings and providers in a window. It talks to JARVIS on
          this computer, so do the four steps first.
        </p>
        <p class="mono text-muted dl-release">
          {app ? `Latest: ${app.tag_name}` : "See the releases on GitHub."}
        </p>
        <div class="dl-buttons">
          {appButtons.map((b) => (
            <a href={b.href} class="btn btn-primary">{b.label}</a>
          ))}
          <a href={`${gh}/jarvis-app/releases/latest`} class="btn btn-outline"
             target="_blank" rel="noopener noreferrer">All downloads ↗</a>
        </div>
        <p class="step-note">
          Builds are unsigned for now: Windows SmartScreen warns (More info → Run anyway) and
          macOS needs right-click → Open the first time. The macOS build is Apple silicon only.
          Linux needs WebKitGTK&nbsp;4.1.
        </p>
      </div>

      <div class="more-way" id="phone">
        <span class="section-label">Your phone</span>
        <h2>JARVIS in your pocket</h2>
        <p>
          <code>jarvis web</code> serves the same app to your phone over Tailscale, your own
          private network. Only the people you allow get in, and guests can chat but can't
          approve anything.
        </p>
        <div class="dl-buttons">
          <a href={`${gh}/Project-JARVIS/blob/main/docs/web-gateway.md`} class="btn btn-outline"
             target="_blank" rel="noopener noreferrer">How to set it up ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="jarvisos">
    <div class="container os-grid">
      <div>
        <span class="section-label">The whole system</span>
        <h2 class="section-title">JarvisOS</h2>
        <p class="section-lede">
          Arch Linux with JARVIS built in: KDE Plasma 6, JARVIS and llama.cpp installed, and
          its own kernel with a <code>/dev/jarvis</code> device, so the system itself can talk
          to the AI.
        </p>
      </div>
      {iso ? (
        <div class="card os-card">
          <span class="tag tag-medium">Released {released}</span>
          <h3>{os.name || os.tag_name}</h3>
          <p>Flash it to a USB stick, boot it, and try JARVIS before you install.</p>
          <div class="dl-buttons">
            <a href={iso.browser_download_url} class="btn btn-primary">Download ISO</a>
            <a href="/docs/building-the-iso" class="btn btn-outline">How to build it →</a>
            <a href={os.html_url} class="btn btn-outline"
               target="_blank" rel="noopener noreferrer">Release notes ↗</a>
          </div>
          {checksum && (
            <div class="checksum-block">
              <span class="section-label">SHA-512 checksum</span>
              <pre class="mono checksum-pre"><code>{checksum}</code></pre>
            </div>
          )}
        </div>
      ) : (
        <div class="card os-card">
          <span class="tag tag-medium">Not released yet</span>
          <h3>No ISO to download yet</h3>
          <p>
            You can build one on an Arch-based computer with 16&nbsp;GB of RAM and 60&nbsp;GB free.
            The build runs end to end; booting it live and the installer are still being finished.
          </p>
          <div class="dl-buttons">
            <a href="/docs/building-the-iso" class="btn btn-outline">How to build it →</a>
            <a href={`${gh}/jarvisos/releases`} class="btn btn-outline"
               target="_blank" rel="noopener noreferrer">Releases ↗</a>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .dl-hero .section-lede {
    max-width: 620px;
  }

  .dl-needs {
    margin-top: var(--space-lg);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .dl-jump {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3xl);
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .step-copy h2 {
    font-size: 1.6rem;
    margin: var(--space-sm) 0 var(--space-sm);
  }

  .step-copy p {
    color: var(--text-secondary);
  }

  .step-n {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid var(--border-glow);
    background: #00c8ff14;
    color: var(--cyan);
    font-size: 1rem;
  }

  .step-copy .step-note,
  .more-way .step-note {
    margin-top: var(--space-md);
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .code {
    position: relative;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .code pre {
    margin: 0;
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-primary);
  }

  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.5rem 0.35rem var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .code-copy {
    padding: 0.2rem 0.7rem;
    font: inherit;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  .code-copy:hover,
  .code-copy:focus-visible {
    color: var(--cyan);
    border-color: var(--border-glow);
  }

  .more-ways {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
  }

  .more-way h2 {
    font-size: 1.8rem;
    margin: var(--space-sm) 0 var(--space-md);
  }

  .more-way > p {
    color: var(--text-secondary);
  }

  .dl-release {
    margin-top: var(--space-lg);
    font-size: 0.85rem;
  }

  .dl-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .os-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .os-card {
    padding: var(--space-2xl);
  }

  .os-card h3 {
    font-size: 1.4rem;
    margin: var(--space-md) 0 var(--space-sm);
  }

  .checksum-pre {
    margin-top: var(--space-sm);
    padding: var(--space-md);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.75rem;
    overflow-x: auto;
    word-break: break-all;
  }

  .checksum-block {
    margin-top: var(--space-xl);
  }

  @media (max-width: 860px) {
    .step,
    .more-ways,
    .os-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .step {
      gap: var(--space-lg);
    }

    .steps {
      gap: var(--space-2xl);
    }
  }
</style>

<script>
  // Copy buttons: copy the block's text and say so for a moment.
  for (const block of document.querySelectorAll<HTMLElement>("[data-code]")) {
    const button = block.querySelector<HTMLButtonElement>(".code-copy");
    const code = block.querySelector("code");
    if (!button || !code) continue;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.textContent = "Copied";
      } catch {
        // No clipboard access: select the text so Ctrl+C copies it.
        const range = document.createRange();
        range.selectNodeContents(code);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
        button.textContent = "Selected";
      }
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  }
</script>
