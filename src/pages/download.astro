---
import BaseLayout from "../layouts/BaseLayout.astro";

const downloadSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JARVIS OS",
  operatingSystem: "Linux",
  applicationCategory: "OperatingSystem",
  description:
    "Bootable Arch Linux ISO with Ollama local LLM inference, KDE Plasma 6, MCP orchestration layer, and the JARVIS AI assistant daemon. Purpose-built for LLM security research.",
  url: "https://jarvisoslinux.org",
  downloadUrl: "https://jarvisoslinux.org/download",
  author: {
    "@type": "Organization",
    name: "JarvisOSLinux",
    url: "https://github.com/JarvisOSLinux",
  },
});
---

<BaseLayout
  title="Download JARVIS"
  description="Get JARVIS three ways: the JarvisOS ISO, the desktop app for Windows/macOS/Linux, or the CLI/TUI daemon via pip install project-jarvis."
>
  <script slot="head" type="application/ld+json" set:html={downloadSchema} />
  <section class="section">
    <div class="container">
      <span class="section-label">Download</span>
      <h1 class="section-title">Get JARVIS</h1>
      <p class="dl-intro">
        Three ways in: boot <strong>JarvisOS</strong> — the full AI-native operating system —
        run the <strong>Jarvis App</strong> on the desktop you already have, or install the
        <strong>CLI/TUI</strong> daemon straight from PyPI. The app and CLI both talk to the
        same JARVIS daemon; the OS ships all of it preconfigured.
      </p>
    </div>
  </section>

  <!-- JarvisOS — latest ISO release (populated by GitHub API at runtime) -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <span class="section-label">JarvisOS</span>
      <h2 class="section-title">The full system</h2>
      <div class="card release-card glow-border" id="latest-release">
        <div class="release-header">
          <span class="tag tag-medium">Latest Release</span>
          <span class="mono text-muted" id="release-date">Loading...</span>
        </div>
        <h2 id="release-tag" style="margin-top: var(--space-md);">Fetching latest release...</h2>
        <p id="release-body" style="margin-top: var(--space-sm);">
          Connecting to GitHub API to fetch the latest release information.
        </p>
        <div class="release-actions" style="margin-top: var(--space-xl);">
          <a href="#" class="btn btn-primary" id="download-btn" style="display: none;">
            Download ISO
          </a>
          <a href="#" class="btn btn-outline" id="release-link" style="display: none;">
            Release notes &nearr;
          </a>
        </div>
        <div id="checksum-block" style="display: none; margin-top: var(--space-xl);">
          <span class="section-label">SHA-512 Checksum</span>
          <pre class="mono checksum-pre"><code id="checksum-value"></code></pre>
        </div>
      </div>

      <!-- Fallback if no releases -->
      <noscript>
        <div class="card" style="margin-top: var(--space-lg);">
          <p>
            JavaScript is required to fetch the latest release from GitHub. You can also
            browse releases directly at
            <a href="https://github.com/JarvisOSLinux/jarvisos/releases" target="_blank" rel="noopener noreferrer">
              github.com/JarvisOSLinux/jarvisos/releases</a>.
          </p>
        </div>
      </noscript>
    </div>
  </section>

  <!-- Jarvis App — desktop app releases (populated by GitHub API at runtime) -->
  <section class="section">
    <div class="container">
      <span class="section-label">Jarvis App</span>
      <h2 class="section-title">The desktop app</h2>
      <div class="card release-card glow-border">
        <div class="release-header">
          <span class="tag tag-medium">Latest Release</span>
          <span class="mono text-muted" id="app-release-tag">Loading&hellip;</span>
        </div>
        <p style="margin-top: var(--space-md);">
          A native chat window for the JARVIS daemon &mdash; sessions, live permission
          requests with per-task approval, and desktop widgets. Requires the daemon
          (install the CLI below, or run JarvisOS).
        </p>
        <div class="release-actions" style="margin-top: var(--space-xl);" id="app-buttons">
          <a href="https://github.com/JarvisOSLinux/jarvis-app/releases/latest" class="btn btn-outline"
             target="_blank" rel="noopener noreferrer">All downloads &nearr;</a>
        </div>
        <p class="text-muted" style="margin-top: var(--space-lg); font-size: 0.9rem;">
          Builds are currently unsigned: Windows SmartScreen warns (&ldquo;More info &rarr;
          Run anyway&rdquo;) and macOS needs right-click &rarr; Open on first launch. The
          macOS build is Apple silicon only for now. Linux needs WebKitGTK&nbsp;4.1.
        </p>
      </div>
    </div>
  </section>

  <!-- Jarvis CLI/TUI — the daemon itself -->
  <section class="section">
    <div class="container">
      <span class="section-label">Jarvis CLI / TUI</span>
      <h2 class="section-title">The daemon, anywhere</h2>
      <div class="card release-card glow-border">
        <p>
          Project-JARVIS is the brain: LLM orchestration, the TLA security gate, MCP tool
          dispatch, voice, and both terminal interfaces. Its download is a package, not a
          file:
        </p>
        <pre class="mono install-cmd" style="margin-top: var(--space-md);"><code>pip install project-jarvis
jarvis providers add --type ollama --model qwen3:4b
jarvis chat   # or: jarvis tui</code></pre>
        <div class="release-actions" style="margin-top: var(--space-xl);">
          <a href="https://pypi.org/project/project-jarvis/" class="btn btn-primary"
             target="_blank" rel="noopener noreferrer">PyPI &nearr;</a>
          <a href="https://github.com/JarvisOSLinux/Project-JARVIS" class="btn btn-outline"
             target="_blank" rel="noopener noreferrer">Source &amp; docs &nearr;</a>
        </div>
        <p class="text-muted" style="margin-top: var(--space-lg); font-size: 0.9rem;">
          Linux is the reference platform. Windows and macOS are supported in beta
          (Python 3.11&ndash;3.13 recommended); tool servers from the MCP registry are
          mostly Linux-only today.
        </p>
      </div>
      <div class="card" style="margin-top: var(--space-lg);">
        <h3>Sidecars</h3>
        <p>
          The daemon orchestrates three small Rust binaries. They install with JarvisOS and
          build with <code>cargo</code>; prebuilt per-OS binaries live on each repo&rsquo;s
          releases page:
          <a href="https://github.com/JarvisOSLinux/dispatch/releases" target="_blank" rel="noopener noreferrer">dispatch</a> (task orchestrator) &middot;
          <a href="https://github.com/JarvisOSLinux/dmcp/releases" target="_blank" rel="noopener noreferrer">dmcp</a> (MCP server manager) &middot;
          <a href="https://github.com/JarvisOSLinux/contextor/releases" target="_blank" rel="noopener noreferrer">contextor</a> (long-term memory).
        </p>
      </div>
    </div>
  </section>

  <!-- Install instructions -->
  <section class="section">
    <div class="container">
      <span class="section-label">Getting Started</span>
      <h2 class="section-title">Installing JarvisOS</h2>
      <div class="grid-2">
        <div class="card">
          <h3>1. Boot from USB</h3>
          <p>
            Flash the ISO to a USB drive using <code>dd</code>, Ventoy, or Balena Etcher.
            Boot from the USB and you'll land in the live environment.
          </p>
          <pre class="mono install-cmd"><code>sudo dd if=jarvisos-*.iso of=/dev/sdX bs=4M status=progress</code></pre>
        </div>
        <div class="card">
          <h3>2. Live Environment</h3>
          <p>
            The live session gives you a fully functional JARVIS OS with KDE Plasma 6.
            Test the AI features, explore the system, and run the <code>jarvis</code> CLI.
          </p>
        </div>
        <div class="card">
          <h3>3. Install to Disk</h3>
          <p>
            Launch the Calamares installer from the desktop for a guided installation
            to your hard drive — automatic partitioning, user setup, and bootloader
            configuration included.
          </p>
        </div>
        <div class="card">
          <h3>4. Virtual Machine</h3>
          <p>
            JARVIS OS runs well in VirtualBox or QEMU/KVM. Allocate at least 4 GB RAM
            and 20 GB disk for comfortable usage with local LLM inference.
          </p>
          <pre class="mono install-cmd"><code>qemu-system-x86_64 -m 4G -smp 4 -cdrom jarvisos-*.iso</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Mirrors / source -->
  <section class="section">
    <div class="container">
      <span class="section-label">Source</span>
      <h2 class="section-title">Build from source</h2>
      <div class="card">
        <p>
          JARVIS OS is fully open source. Clone the build system and run the nine-script
          pipeline to produce your own ISO from scratch.
        </p>
        <pre class="mono install-cmd" style="margin-top: var(--space-md);"><code>git clone https://github.com/JarvisOSLinux/jarvisos.git
cd jarvisos
sudo ./01-*.sh   # begin the build pipeline</code></pre>
        <a
          href="https://github.com/JarvisOSLinux/jarvisos"
          class="btn btn-outline"
          style="margin-top: var(--space-lg);"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub &nearr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dl-intro {
    font-size: 1.05rem;
    max-width: 640px;
  }

  .release-card {
    padding: var(--space-2xl);
  }

  .release-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .release-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .checksum-pre {
    margin-top: var(--space-sm);
    padding: var(--space-md);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.75rem;
    overflow-x: auto;
    word-break: break-all;
  }

  .install-cmd {
    margin-top: var(--space-md);
    padding: var(--space-md);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.8rem;
    overflow-x: auto;
  }
</style>

<script>
  async function fetchRelease() {
    try {
      const res = await fetch(
        "https://api.github.com/repos/JarvisOSLinux/jarvisos/releases/latest"
      );
      if (!res.ok) throw new Error("No releases found");
      const data = await res.json();

      const tagEl = document.getElementById("release-tag");
      const dateEl = document.getElementById("release-date");
      const bodyEl = document.getElementById("release-body");
      const dlBtn = document.getElementById("download-btn") as HTMLAnchorElement;
      const rlBtn = document.getElementById("release-link") as HTMLAnchorElement;

      if (tagEl) tagEl.textContent = data.name || data.tag_name;
      if (dateEl)
        dateEl.textContent = new Date(data.published_at).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        });
      if (bodyEl) bodyEl.textContent = data.body?.slice(0, 300) || "No description.";

      // Find ISO asset
      const iso = data.assets?.find((a: any) => a.name.endsWith(".iso"));
      if (iso && dlBtn) {
        dlBtn.href = iso.browser_download_url;
        dlBtn.style.display = "inline-flex";
      }

      if (rlBtn) {
        rlBtn.href = data.html_url;
        rlBtn.style.display = "inline-flex";
      }

      // Fire-and-forget: a checksum failure must never break the release UI
      loadChecksum(data, iso?.name ?? null);
    } catch {
      const tagEl = document.getElementById("release-tag");
      const bodyEl = document.getElementById("release-body");
      if (tagEl) tagEl.textContent = "No releases yet";
      if (bodyEl)
        bodyEl.innerHTML =
          'Check <a href="https://github.com/JarvisOSLinux/jarvisos/releases">GitHub releases</a> directly.';
    }
  }

  // Populate #checksum-block from the release: prefer a dedicated checksum
  // asset (<name>.sha512 / SHA512SUMS*), fall back to a 128-hex digest in the
  // release notes. Leaves the block hidden when neither exists. Never throws.
  async function loadChecksum(data: any, isoName: string | null) {
    try {
      const block = document.getElementById("checksum-block");
      const valueEl = document.getElementById("checksum-value");
      if (!block || !valueEl) return;

      const SHA512_RE = /\b[0-9a-fA-F]{128}\b/;
      const show = (hex: string) => {
        valueEl.textContent = hex;
        block.style.display = "block";
      };

      const sumAsset = data.assets?.find(
        (a: any) =>
          a.name.toLowerCase().endsWith(".sha512") ||
          a.name.toUpperCase().startsWith("SHA512SUMS")
      );
      if (sumAsset) {
        try {
          const res = await fetch(sumAsset.browser_download_url);
          if (res.ok) {
            const lines = (await res.text()).trim().split("\n");
            const line =
              (isoName && lines.find((l) => l.includes(isoName))) || lines[0];
            const hex = line?.match(SHA512_RE)?.[0];
            if (hex) {
              show(hex);
              return;
            }
          }
        } catch {
          /* fall through to release-body scan */
        }
      }

      const bodyHex = data.body?.match(SHA512_RE)?.[0];
      if (bodyHex) show(bodyHex);
    } catch {
      /* checksum display is best-effort; block stays hidden */
    }
  }

  // Jarvis App: same latest-release pattern as the ISO card, with per-OS
  // asset buttons matched by filename. Filenames carry the version, so
  // fetching latest keeps links fresh without a site redeploy.
  async function fetchAppRelease() {
    const tagEl = document.getElementById("app-release-tag");
    try {
      const res = await fetch(
        "https://api.github.com/repos/JarvisOSLinux/jarvis-app/releases/latest"
      );
      if (!res.ok) throw new Error("No releases found");
      const data = await res.json();
      if (tagEl) tagEl.textContent = data.name || data.tag_name;

      const buttons = document.getElementById("app-buttons");
      if (!buttons) return;
      const groups: Array<[string, (n: string) => boolean]> = [
        ["Windows", (n) => n.endsWith("-setup.exe") || n.endsWith(".msi")],
        ["macOS", (n) => n.endsWith(".dmg")],
        ["Linux (AppImage)", (n) => n.endsWith(".AppImage")],
        ["Linux (deb)", (n) => n.endsWith(".deb")],
        ["Linux (rpm)", (n) => n.endsWith(".rpm")],
      ];
      for (const [label, match] of groups) {
        const asset = data.assets?.find((a: any) => match(a.name));
        if (!asset) continue;
        const a = document.createElement("a");
        a.href = asset.browser_download_url;
        a.className = "btn btn-primary";
        a.textContent = label;
        buttons.prepend(a);
      }
    } catch {
      if (tagEl) tagEl.textContent = "see GitHub";
    }
  }

  fetchRelease();
  fetchAppRelease();
</script>
