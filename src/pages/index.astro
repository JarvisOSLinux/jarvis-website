---
import BaseLayout from "../layouts/BaseLayout.astro";
import registry from "../data/servers.json";

const serverCount = registry.servers.length;

const softwareSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JARVIS",
  operatingSystem: "Linux",
  applicationCategory: "UtilitiesApplication",
  description:
    "An AI assistant that does your work on your own computer, with an AI model that can run there too: your data stays with you, and nothing changes without your approval. Built against six security threats identified in research at WSU Everett.",
  url: "https://jarvisoslinux.org",
  downloadUrl: "https://jarvisoslinux.org/download",
  isAccessibleForFree: true,
  author: {
    "@type": "Organization",
    name: "JarvisOSLinux",
    url: "https://github.com/JarvisOSLinux",
  },
  keywords:
    "private AI assistant, local AI, AI agent security, data privacy, prompt injection, Linux, llama.cpp, Model Context Protocol, open source",
});

const researchSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ResearchProject",
  name: "JARVIS OS — LLM-OS Security Research",
  description:
    "Empirical study of security threats that emerge when LLMs gain OS-level privileges. Produces the first threat taxonomy for AI-native operating systems.",
  url: "https://jarvisoslinux.org/research",
  funder: {
    "@type": "CollegeOrUniversity",
    name: "Washington State University Everett",
  },
  member: [
    { "@type": "Person", name: "Yakup Atahanov" },
    { "@type": "Person", name: "Toufic Majdalani" },
  ],
});

// What the hero types out: work that touches your own data. Each one is
// something a registry server does (email, microsoft-365, files, shell).
const heroAsks = [
  "Did my professor email me back?",
  "What's on my calendar tomorrow?",
  "Find last week's lecture notes",
  "Update my system",
  "Sort my Downloads folder",
];

// The problem, as three risks, each with what JARVIS does about it.
const risks = [
  {
    risk: "What it reads goes to someone else's servers.",
    answer: "It runs on your computer, and so can its AI model.",
    href: "#yours",
  },
  {
    risk: "It changes things you never asked for.",
    answer: "Anything that changes something waits for your yes.",
    href: "#yes",
  },
  {
    risk: "A web page, an email or a bad tool gives it orders.",
    answer: "Outside text is marked as data, and every tool is reviewed first.",
    href: "#attacks",
  },
];

// The six threats from the research, each with its fix in plain words.
// Names and severities match /research; fixes stay within what main does.
const threats = [
  {
    name: "Malicious MCP Servers",
    fix: "Every tool is reviewed and rated before JARVIS can install it, and one pulled from the registry later is blocked.",
    tags: ["critical"],
  },
  {
    name: "Prompt Injection",
    fix: "Text from web pages and emails arrives sealed and marked as data, never as instructions.",
    tags: ["critical"],
  },
  {
    name: "Misleading MCP Server Usage",
    fix: "Tool descriptions are checked for accuracy before a tool enters the registry.",
    tags: ["high"],
  },
  {
    name: "Unauthorized Sudo Requests via MCP",
    fix: "Root takes your password, out of the AI's reach, every time.",
    tags: ["critical"],
  },
  {
    name: "Sudo Capability Exploitation",
    fix: "Each privileged step is checked and confirmed on its own, so one yes is never a blank check.",
    tags: ["critical"],
  },
  {
    name: "Bloated Context",
    fix: "Partly solved: folder rules you set are stored and enforced outside the AI's memory. Wider rules are next.",
    tags: ["critical", "novel"],
  },
];
---

<BaseLayout
  fullTitle="JARVIS: Hand AI your work, not your data."
  description="JARVIS is an AI assistant that does your work on your own computer, with an AI model that can run there too. No AI company sees your data, and nothing changes without your yes. Free and open source, built from security research at WSU Everett."
>
  <script slot="head" type="application/ld+json" set:html={softwareSchema} />
  <script slot="head" type="application/ld+json" set:html={researchSchema} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow mono animate-fade-up">Security-first AI assistant</p>
      <h1 class="animate-fade-up animate-fade-up--delay-1">
        Hand AI your work,<br /><span class="hl">not your data.</span>
      </h1>
      <p class="hero-sub animate-fade-up animate-fade-up--delay-2">
        JARVIS does the work on your own computer: your files, email, calendar and system, with
        an AI model that runs there too. No AI company sees your data, and nothing changes
        without your yes.
      </p>

      <div class="ask-bar animate-fade-up animate-fade-up--delay-2" aria-hidden="true">
        <span class="ask-prompt mono">Ask</span>
        <span class="ask-text" id="ask-text">{heroAsks[0]}</span><span class="ask-caret"></span>
      </div>

      <div class="hero-actions animate-fade-up animate-fade-up--delay-3">
        <a href="/download" class="btn btn-primary">Get JARVIS</a>
        <a href="#problem" class="btn btn-outline">How it keeps your data</a>
      </div>
      <ul class="hero-facts mono animate-fade-up animate-fade-up--delay-3">
        <li>Runs on your Linux computer</li>
        <li>Nothing changes without your yes</li>
        <li>Open source, so you can check</li>
      </ul>
    </div>

    <div class="container">
      <div class="hero-visual" aria-label="JARVIS installing a package and waiting for approval">
        <figure class="screen hero-screen">
          <div class="screen-bar"><i></i><i></i><i></i><span>jarvis-app</span></div>
          <img
            src="/assets/screens/app-approval.webp"
            width="1600"
            height="1030"
            alt="The JARVIS app: asked to install a package, JARVIS found the root shell tool, started pacman as a job, and shows pacman asking to proceed while it waits for approval."
            fetchpriority="high"
          />
        </figure>
        <figure class="phone hero-phone">
          <img
            src="/assets/screens/phone-waiting.webp"
            width="640"
            height="1385"
            alt="The same request on a phone, with pacman's question in the job's output and one permission request waiting."
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- The problem -->
  <section class="section" id="problem">
    <div class="container">
      <div class="problem-head">
        <span class="section-label">The problem</span>
        <h2>AI can only help with what it can reach.</h2>
        <p class="section-lede">
          Your email, your files, your calendar, your computer. Letting an AI work on them
          usually means trusting it with all of it. JARVIS was built so you don't have to.
        </p>
      </div>

      <div class="risks card" role="table" aria-label="The risks, and what JARVIS does about each">
        <div class="risks-row risks-row--head" role="row">
          <span class="mono" role="columnheader">The risk</span>
          <span class="mono hl" role="columnheader">With JARVIS</span>
        </div>
        {risks.map((r) => (
          <a class="risks-row" href={r.href} role="row">
            <span class="risk" role="cell">{r.risk}</span>
            <span class="answer" role="cell">{r.answer}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 1. Your data stays yours -->
  <section class="section feature section--band" id="yours">
    <div class="container feature-grid">
      <div class="feature-copy">
        <span class="section-label">Your data stays yours</span>
        <h2>No AI company sees your data.</h2>
        <p class="section-lede">
          JARVIS runs on your computer, and so can its AI model. What you ask, what it reads and
          what it remembers stay there. No account to make, and no server of ours in the middle.
        </p>
        <ul class="checks">
          <li>Pick a model and JARVIS downloads it and runs it on your computer with llama.cpp. The model works offline.</li>
          <li>Its memory is a file on your computer, not an account in someone's cloud.</li>
          <li>Your phone reaches it over your own Tailscale network, never through a server of ours. Your API keys never leave the computer.</li>
          <li>Listening for “Hey JARVIS” and speaking back both run on your computer too.</li>
          <li>Want a bigger cloud model? You can add one, and then what you ask goes to that provider. Your choice, never the default.</li>
        </ul>
      </div>

      <div class="flow card" aria-label="Where your data goes">
        <p class="flow-head mono">Where your data goes</p>
        <div class="flow-home">
          <p class="flow-home-name">Your computer</p>
          <ul class="flow-chips mono">
            <li>JARVIS</li>
            <li>AI model</li>
            <li>Memory</li>
            <li>API keys</li>
          </ul>
        </div>
        <ul class="flow-out">
          <li>
            <span class="flow-who">Your phone</span>
            <span class="flow-what mono">over your own Tailscale</span>
          </li>
          <li>
            <span class="flow-who">Mail and calendar you connect</span>
            <span class="flow-what mono">only what you ask for</span>
          </li>
          <li class="flow-none">
            <span class="flow-who">AI companies</span>
            <span class="flow-what mono">nothing, with a local model</span>
          </li>
          <li class="flow-none">
            <span class="flow-who">Us</span>
            <span class="flow-what mono">nothing</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Nothing without your yes -->
  <section class="section feature" id="yes">
    <div class="container feature-grid feature-grid--flip">
      <div class="feature-copy">
        <span class="section-label">Nothing without your yes</span>
        <h2>It asks before it changes anything.</h2>
        <p class="section-lede">
          JARVIS looks things up on its own. Anything that changes your computer, sends something
          or signs in waits for you, and you see the exact command first.
        </p>
        <ul class="checks">
          <li>Root takes your password, every time. JARVIS never holds root itself.</li>
          <li>Nothing hidden: every search, install and command shows up with its live output.</li>
          <li>Stop means stop. A running update is left to finish, so your system isn't left half-installed, unless you insist.</li>
        </ul>
      </div>
      <div class="tiers-card card" aria-label="What runs on its own and what waits for you">
        <div class="tier">
          <span class="tier-dot tier-dot--safe"></span>
          <div>
            <p class="tier-name">Just does it <span class="tier-level mono lvl-safe">safe</span></p>
            <p class="tier-what">Searching, reading, checking the weather, looking at your system.</p>
          </div>
        </div>
        <div class="tier">
          <span class="tier-dot tier-dot--ask"></span>
          <div>
            <p class="tier-name">Asks you first <span class="tier-level mono lvl-elevated">elevated</span></p>
            <p class="tier-what">Signing in, reading your email or files, anything private.</p>
          </div>
        </div>
        <div class="tier">
          <span class="tier-dot tier-dot--danger"></span>
          <div>
            <p class="tier-name">Asks you first <span class="tier-level mono lvl-dangerous">dangerous</span></p>
            <p class="tier-what">Installing, deleting, sending messages, running commands.</p>
          </div>
        </div>
        <p class="tiers-foot mono">Every tool in the registry is reviewed and rated before JARVIS can install it.</p>
      </div>
    </div>
  </section>

  <!-- 3. Built against the known attacks -->
  <section class="section section--band research-band" id="attacks">
    <div class="container research-grid">
      <div>
        <span class="section-label">Built against the known attacks</span>
        <h2>We studied how AI on a computer goes wrong. Then we built the fixes.</h2>
        <p class="section-lede">
          JARVIS comes out of research at Washington State University Everett. Give an AI real
          access to a computer and six threats appear. Each one has a fix in JARVIS, and the code
          is open for anyone to check.
        </p>
        <p class="award mono">SURCA 2026 · Winner, Gray Grant</p>
        <a href="/research" class="btn btn-outline">Read the research</a>
      </div>
      <ol class="threat-list">
        {threats.map((t, i) => (
          <li>
            <span class="mono threat-n">{String(i + 1).padStart(2, "0")}</span>
            <span class="threat-body">
              <span class="threat-name">{t.name}</span>
              <span class="threat-fix">{t.fix}</span>
            </span>
            <span class="threat-tags">
              {t.tags.map((tag) => <span class:list={["tag", `tag-${tag}`]}>{tag}</span>)}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Also -->
  <section class="section section--tight also-section">
    <div class="container also">
      <p>
        It also works from your phone, answers to “Hey JARVIS”, and finds the tools it needs in
        a reviewed registry of {serverCount} tools.
      </p>
      <div class="also-links">
        <a href="/docs/what-jarvis-can-do" class="btn btn-outline">Everything it can do →</a>
        <a href="/servers" class="also-link mono">Browse the tools</a>
      </div>
    </div>
  </section>

  <!-- Get it -->
  <section class="section get-section">
    <div class="container">
      <div class="get-head">
        <h2>Hand AI your work. Keep your data.</h2>
        <p class="section-lede">Free and open source. Pick how you want it.</p>
      </div>
      <div class="grid-3 get-grid">
        <a class="card get" href="/download#app">
          <h3>The app</h3>
          <p>A desktop window for JARVIS: chat, approvals, settings, providers. Linux, macOS and Windows.</p>
          <span class="get-more mono">Download →</span>
        </a>
        <a class="card get" href="/download#daemon">
          <h3>On the Linux you have</h3>
          <p>JARVIS itself, with its terminal UI, on the distribution you already run.</p>
          <span class="get-more mono">Install →</span>
        </a>
        <a class="card get" href="/download#jarvisos">
          <h3>JarvisOS</h3>
          <p>The whole system on Arch Linux and KDE Plasma 6, built from source with one pipeline.</p>
          <span class="get-more mono">Build it →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ heroAsks }}>
  const el = document.getElementById("ask-text");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms) => new Promise((r) => setTimeout(r, ms));

  async function cycle() {
    let i = 0;
    for (;;) {
      await wait(2600);
      const next = heroAsks[(i = (i + 1) % heroAsks.length)];
      if (still) {
        el.textContent = next;
        continue;
      }
      for (let n = el.textContent.length; n >= 0; n--) {
        el.textContent = el.textContent.slice(0, n);
        await wait(22);
      }
      for (let n = 1; n <= next.length; n++) {
        el.textContent = next.slice(0, n);
        await wait(55);
      }
    }
  }

  if (el) cycle();
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: calc(var(--space-3xl) + 1.5rem) 0 var(--space-3xl);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: -10% 0 auto;
    height: 900px;
    background: radial-gradient(closest-side, #00c8ff1f, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .hero h1 {
    font-size: clamp(2.7rem, 7.4vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin-bottom: var(--space-xl);
  }

  .hl {
    color: var(--cyan);
  }

  .hero-sub {
    font-size: 1.25rem;
    line-height: 1.6;
    max-width: 42rem;
    margin: 0 auto var(--space-xl);
  }

  .ask-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: min(32rem, 100%);
    padding: 0.85rem 1.1rem;
    margin-bottom: var(--space-xl);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-card);
    box-shadow: 0 0 50px -18px #00c8ff55;
    text-align: left;
  }

  .ask-prompt {
    font-size: 0.72rem;
    color: #04121a;
    background: var(--cyan);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ask-text {
    font-size: 1.05rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .ask-caret {
    flex: none;
    width: 2px;
    height: 1.2em;
    margin-left: -0.5rem;
    background: var(--cyan);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    list-style: none;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .hero-facts li::before {
    content: "✓ ";
    color: var(--cyan);
  }

  .hero-visual {
    position: relative;
    max-width: 1040px;
    margin: var(--space-3xl) auto 0;
    padding-right: 4rem;
  }

  .hero-screen img {
    width: 100%;
    height: auto;
  }

  .hero-phone {
    position: absolute;
    width: 24%;
    max-width: 230px;
    right: 0;
    bottom: -2.5rem;
  }

  .hero-phone img {
    width: 100%;
    height: auto;
  }

  /* The problem */
  .problem-head {
    max-width: 46rem;
    margin-bottom: var(--space-2xl);
  }

  .problem-head h2 {
    margin-bottom: var(--space-lg);
  }

  .risks {
    padding: 0;
    overflow: hidden;
  }

  .risks-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
    padding: 1.35rem var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
    color: inherit;
    transition: background var(--transition-fast);
  }

  .risks-row:last-child {
    border-bottom: none;
  }

  a.risks-row:hover {
    background: var(--bg-card-hover);
    color: inherit;
  }

  .risks-row--head {
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    border-bottom-color: var(--border);
  }

  .risk {
    position: relative;
    padding-left: 1.6rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .risk::before {
    content: "✕";
    position: absolute;
    left: 0;
    color: var(--gold);
  }

  .answer {
    position: relative;
    padding-left: 1.6rem;
    color: var(--text-primary);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .answer::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--cyan);
  }

  /* Feature rows */
  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .feature-grid--flip .feature-copy {
    order: 2;
  }

  .feature h2 {
    margin-bottom: var(--space-lg);
    max-width: 18ch;
  }

  .feature .section-lede {
    margin-bottom: var(--space-xl);
  }

  .checks {
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  .checks li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .checks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    border: 1.5px solid var(--cyan);
    background: radial-gradient(circle, var(--cyan) 0 30%, transparent 34%);
  }

  /* Where your data goes */
  .flow {
    padding: 0;
    overflow: hidden;
  }

  .flow-head {
    max-width: none;
    padding: var(--space-md) var(--space-xl);
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .flow-home {
    margin: var(--space-lg) var(--space-xl);
    padding: var(--space-lg);
    border: 1px solid var(--border-glow);
    border-radius: var(--radius);
    background: var(--cyan-wash);
    box-shadow: 0 0 40px -16px #00c8ff55 inset;
  }

  .flow-home-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: var(--space-md);
  }

  .flow-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    font-size: 0.78rem;
  }

  .flow-chips li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--cyan-soft);
  }

  .flow-out {
    list-style: none;
  }

  .flow-out li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-md);
    align-items: baseline;
    padding: 0.95rem var(--space-xl);
    border-top: 1px solid var(--border-subtle);
  }

  .flow-who {
    color: var(--text-primary);
    font-weight: 500;
  }

  .flow-who::before {
    content: "→ ";
    color: var(--cyan);
  }

  .flow-what {
    font-size: 0.75rem;
    color: var(--cyan-soft);
    text-align: right;
  }

  .flow-none .flow-who {
    color: var(--text-secondary);
  }

  .flow-none .flow-who::before {
    content: "✕ ";
    color: var(--text-muted);
  }

  .flow-none .flow-what {
    color: var(--green);
  }

  /* Tiers */
  .tiers-card {
    display: grid;
    gap: 0;
    padding: 0;
    overflow: hidden;
  }

  .tier {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    padding: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
  }

  .tier-dot {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.4rem;
    border-radius: 50%;
  }

  .tier-dot--safe { background: var(--green); box-shadow: 0 0 14px #22d68a80; }
  .tier-dot--ask { background: var(--cyan); box-shadow: 0 0 14px #00c8ff80; }
