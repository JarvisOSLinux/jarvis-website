---
import BaseLayout from "../layouts/BaseLayout.astro";
import registry from "../data/servers.json";

const serverCount = registry.servers.length;

const softwareSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JARVIS",
  operatingSystem: "Linux",
  applicationCategory: "UtilitiesApplication",
  description:
    "An AI assistant for Linux that does what you ask on your own computer: it finds and installs the tools it needs from a vetted registry, asks before anything risky, runs local or cloud models, and can be driven from your phone over Tailscale.",
  url: "https://jarvisoslinux.org",
  downloadUrl: "https://jarvisoslinux.org/download",
  isAccessibleForFree: true,
  author: {
    "@type": "Organization",
    name: "JarvisOSLinux",
    url: "https://github.com/JarvisOSLinux",
  },
  keywords:
    "AI assistant, Linux, local AI, llama.cpp, Model Context Protocol, MCP, voice assistant, open source",
});

const researchSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ResearchProject",
  name: "JARVIS OS — LLM-OS Security Research",
  description:
    "Empirical study of security threats that emerge when LLMs gain OS-level privileges. Produces the first threat taxonomy for AI-native operating systems.",
  url: "https://jarvisoslinux.org/research",
  funder: {
    "@type": "CollegeOrUniversity",
    name: "Washington State University Everett",
  },
  member: [
    { "@type": "Person", name: "Yakup Atahanov" },
    { "@type": "Person", name: "Toufic Majdalani" },
  ],
});

// What the hero types out. Each one is a request a registry server answers.
const heroAsks = [
  "Update my system",
  "What's slowing my laptop down?",
  "Pause the music",
  "What's on my calendar tomorrow?",
  "Make me a wallpaper of a foggy forest",
  "Turn off the living room lights",
];

// Things to ask, each with the registry server that does it.
const asks = [
  [
    { ask: "Update my system", tool: "shell (root)" },
    { ask: "What's eating my memory?", tool: "system-status" },
    { ask: "Install VLC", tool: "shell (root)" },
    { ask: "Pause the music", tool: "mpris" },
    { ask: "What's the weather this weekend?", tool: "weather" },
    { ask: "How much is 50 euros in dollars?", tool: "currency" },
    { ask: "How long is the drive to Seattle?", tool: "maps" },
    { ask: "Who was Ada Lovelace?", tool: "wikipedia" },
    { ask: "What's in the news this morning?", tool: "news" },
  ],
  [
    { ask: "What's on my calendar tomorrow?", tool: "caldav" },
    { ask: "Did my professor email me back?", tool: "email" },
    { ask: "Send this to my Telegram", tool: "telegram" },
    { ask: "Turn off the living room lights", tool: "home assistant" },
    { ask: "Make me a wallpaper of a foggy forest", tool: "comfyui" },
    { ask: "Add this to my Obsidian notes", tool: "obsidian" },
    { ask: "What are my open pull requests?", tool: "github" },
    { ask: "Open this page and fill in the form", tool: "playwright" },
    { ask: "Post it in our Slack", tool: "slack" },
  ],
];

const threats = [
  { name: "Malicious MCP Servers", tags: ["critical"] },
  { name: "Prompt Injection", tags: ["critical"] },
  { name: "Misleading MCP Server Usage", tags: ["high"] },
  { name: "Unauthorized Sudo Requests via MCP", tags: ["critical"] },
  { name: "Sudo Capability Exploitation", tags: ["critical"] },
  { name: "Bloated Context", tags: ["critical", "novel"] },
];
---

<BaseLayout
  fullTitle="JARVIS: You ask. JARVIS does."
  description="Tell your Linux computer what you want in plain words. JARVIS works out the steps, installs whatever it's missing and gets it done, and asks before anything risky. Free and open source, with local or cloud AI."
>
  <script slot="head" type="application/ld+json" set:html={softwareSchema} />
  <script slot="head" type="application/ld+json" set:html={researchSchema} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow mono animate-fade-up">Free and open source AI for Linux</p>
      <h1 class="animate-fade-up animate-fade-up--delay-1">
        You ask.<br /><span class="hl">JARVIS does.</span>
      </h1>
      <p class="hero-sub animate-fade-up animate-fade-up--delay-2">
        Tell your computer what you want, in plain words. JARVIS works out the steps, installs
        whatever it's missing and gets it done. Go grab a coffee while it works.{" "}
        <span class="aside">(It can't make the coffee. Yet.)</span>
      </p>

      <div class="ask-bar animate-fade-up animate-fade-up--delay-2" aria-hidden="true">
        <span class="ask-prompt mono">Ask</span>
        <span class="ask-text" id="ask-text">{heroAsks[0]}</span><span class="ask-caret"></span>
      </div>

      <div class="hero-actions animate-fade-up animate-fade-up--delay-3">
        <a href="/download" class="btn btn-primary">Get JARVIS</a>
        <a href="#ask" class="btn btn-outline">See what it can do</a>
      </div>
      <ul class="hero-facts mono animate-fade-up animate-fade-up--delay-3">
        <li>Runs on your computer</li>
        <li>Asks before anything risky</li>
        <li>Works from your phone</li>
      </ul>
    </div>

    <div class="container">
      <div class="hero-visual" aria-label="JARVIS installing a package and waiting for approval">
        <figure class="screen hero-screen">
          <div class="screen-bar"><i></i><i></i><i></i><span>jarvis-app</span></div>
          <img
            src="/assets/screens/app-approval.webp"
            width="1600"
            height="1030"
            alt="The JARVIS app: asked to install a package, JARVIS found the root shell tool, started pacman as a job, and shows pacman asking to proceed while it waits for approval."
            fetchpriority="high"
          />
        </figure>
        <figure class="phone hero-phone">
          <img
            src="/assets/screens/phone-waiting.webp"
            width="640"
            height="1385"
            alt="The same request on a phone, with pacman's question in the job's output and one permission request waiting."
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Why: does vs tells -->
  <section class="section" id="why">
    <div class="container">
      <div class="why-head">
        <span class="section-label">Why JARVIS</span>
        <h2>Other AI tells you what to type. JARVIS does the typing.</h2>
        <p class="section-lede">
          Ask a chatbot to install something and you get commands to copy, a password to type and
          a question to answer. Ask JARVIS and it gets done. It only stops to check with you.
        </p>
      </div>

      <div class="why-grid">
        <div class="why-col">
          <p class="why-who mono">A chatbot</p>
          <div class="chat card">
            <p class="bubble bubble--you">Install cowsay for me.</p>
            <div class="bubble bubble--bot">
              <p>Sure! Open a terminal and run:</p>
              <code class="cmd">sudo pacman -S cowsay</code>
              <p>Type your password when asked, then press <strong>Y</strong> to confirm.</p>
            </div>
            <p class="chat-foot mono">Your turn.</p>
          </div>
        </div>
        <div class="why-col">
          <p class="why-who mono hl">JARVIS</p>
          <figure class="screen">
            <div class="screen-bar"><i></i><i></i><i></i><span>jarvis-app</span></div>
            <img
              src="/assets/screens/app-done.webp"
              width="1600"
              height="1030"
              loading="lazy"
              alt="The same request in JARVIS: it searched for a tool, ran pacman as a job, sent the Y you approved, and says cowsay is installed."
            />
          </figure>
          <p class="chat-foot mono">Done. You approved one step.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What can it do -->
  <section class="section section--band asks-section" id="ask">
    <div class="container">
      <div class="asks-head">
        <span class="section-label">What can it do?</span>
        <h2>If you can do it on your computer, you can ask for it.</h2>
      </div>
    </div>

    <div class="marquee" aria-label="Things you can ask JARVIS">
      {asks.map((row, i) => (
        <div class:list={["marquee-row", { "marquee-row--reverse": i % 2 === 1 }]}>
          <ul class="marquee-track">
            {[...row, ...row].map((a, j) => (
              <li class="ask-chip" aria-hidden={j >= row.length ? "true" : undefined}>
                <span class="ask-chip-text">“{a.ask}”</span>
                <span class="ask-chip-tool mono">{a.tool}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="container asks-foot">
      <p class="section-lede">
        JARVIS starts with none of these tools. The first time you ask, it finds the right one,
        installs it and carries on. Next time it's already there.
      </p>
      <a href="/servers" class="btn btn-outline">See all {serverCount} tools →</a>
    </div>
  </section>

  <!-- Walk away -->
  <section class="section feature">
    <div class="container feature-grid">
      <div class="feature-copy">
        <span class="section-label">Walk away</span>
        <h2>Grab that coffee. JARVIS keeps going.</h2>
        <p class="section-lede">
          Open JARVIS on your phone and pick up where you left off. Watch it work, answer its
          questions, approve a step or stop it, from the couch or across campus.
        </p>
        <ul class="checks">
          <li>Your phone reaches your computer over your own private Tailscale network, not through a server of ours.</li>
          <li>Your API keys never leave the computer.</li>
          <li>Let others in as guests: they can chat, but can't approve anything or touch your settings.</li>
        </ul>
      </div>
      <div class="feature-visual feature-visual--phone">
        <figure class="phone">
          <img
            src="/assets/screens/phone-waiting.webp"
            width="640"
            height="1385"
            loading="lazy"
            alt="JARVIS on a phone, waiting: pacman asks to proceed and the request is held."
          />
        </figure>
        <img
          class="approval-card"
          src="/assets/screens/approval-card.webp"
          width="760"
          height="266"
          loading="lazy"
          alt="The permission card: answer pacman's question with Y, Approve or Deny."
        />
      </div>
    </div>
  </section>

  <!-- In charge -->
  <section class="section feature section--band" id="safety">
    <div class="container feature-grid feature-grid--flip">
      <div class="feature-copy">
        <span class="section-label">You're in charge</span>
        <h2>It asks before it changes anything.</h2>
        <p class="section-lede">
          JARVIS looks things up on its own. Anything that changes your computer, sends something
          or signs in waits for your yes, and you see the exact command first.
        </p>
        <ul class="checks">
          <li>Root takes your password, every time. JARVIS never holds root itself.</li>
          <li>Stop means stop. A running update is left to finish, so your system isn't left half-installed, unless you insist.</li>
          <li>Text from a web page or an email arrives sealed in a random tag JARVIS checks, marked as data, never as your instructions.</li>
        </ul>
      </div>
      <div class="tiers-card card" aria-label="What runs on its own and what waits for you">
        <div class="tier">
          <span class="tier-dot tier-dot--safe"></span>
          <div>
            <p class="tier-name">Just does it <span class="tier-level mono lvl-safe">safe</span></p>
            <p class="tier-what">Searching, reading, checking the weather, looking at your system.</p>
          </div>
        </div>
        <div class="tier">
          <span class="tier-dot tier-dot--ask"></span>
          <div>
            <p class="tier-name">Asks you first <span class="tier-level mono lvl-elevated">elevated</span></p>
            <p class="tier-what">Signing in, reading your email or files, anything private.</p>
          </div>
        </div>
        <div class="tier">
          <span class="tier-dot tier-dot--danger"></span>
          <div>
            <p class="tier-name">Asks you first <span class="tier-level mono lvl-dangerous">dangerous</span></p>
            <p class="tier-what">Installing, deleting, sending messages, running commands.</p>
          </div>
        </div>
        <p class="tiers-foot mono">Every tool in the registry is reviewed and rated before JARVIS can install it.</p>
      </div>
    </div>
  </section>

  <!-- Your AI -->
  <section class="section feature">
    <div class="container feature-grid">
      <div class="feature-copy">
        <span class="section-label">Your AI, your call</span>
        <h2>Free, private, or both.</h2>
        <p class="section-lede">
          Run an AI model on your own computer and nothing you say leaves it. Or plug in any AI
          provider you like, free tiers included. If one runs out or goes down, JARVIS switches to
          the next on its own.
        </p>
        <ul class="checks">
          <li>Pick a model and JARVIS downloads it and runs it with llama.cpp.</li>
          <li>Works with any OpenAI-compatible API.</li>
          <li>Change providers while it runs. No restart.</li>
        </ul>
      </div>
      <div class="pool card" aria-label="Providers, tried in order">
        <p class="pool-head mono">Tried in order</p>
        <ol>
          <li>
            <span class="pool-n mono">1</span>
            <span class="pool-name">A model on this computer</span>
            <span class="pool-tag mono pool-tag--ok">answering</span>
          </li>
          <li>
            <span class="pool-n mono">2</span>
            <span class="pool-name">A cloud provider</span>
            <span class="pool-tag mono">standing by</span>
          </li>
          <li>
            <span class="pool-n mono">3</span>
            <span class="pool-name">Another one, just in case</span>
            <span class="pool-tag mono">standing by</span>
          </li>
        </ol>
        <p class="pool-foot">Out of credits, rate-limited or offline? JARVIS moves down the list and comes back when it can.</p>
      </div>
    </div>
  </section>

  <!-- More -->
  <section class="section section--tight more-section">
    <div class="container">
      <div class="more-grid">
        <div class="more">
          <h3>Just say “Hey JARVIS”</h3>
          <p>Talk to it hands-free. Listening and speaking both run on your computer, offline.</p>
        </div>
        <div class="more">
          <h3>Ask the next thing right away</h3>
          <p>JARVIS works on more than one request at a time, so you don't wait for the first to finish.</p>
        </div>
        <div class="more">
          <h3>Gets better at your tools</h3>
          <p>It can write itself a how-to for a tool once a task works, so the next time goes right the first time.</p>
        </div>
        <div class="more">
          <h3>Nothing hidden</h3>
          <p>Every search, install and command shows up with its live output. Open any of it, stop any of it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who's behind it -->
  <section class="section section--band research-band">
    <div class="container research-grid">
      <div>
        <span class="section-label">Who's behind it</span>
        <h2>Built by students. Backed by research.</h2>
        <p class="section-lede">
          JARVIS comes out of Washington State University Everett. Handing an AI your computer is
          risky, so we studied exactly how it goes wrong, named six threats, and built JARVIS
          around the fixes.
        </p>
        <p class="award mono">SURCA 2026 · Winner, Gray Grant</p>
        <a href="/research" class="btn btn-outline">Read the research</a>
      </div>
      <ol class="threat-list">
        {threats.map((t, i) => (
          <li>
            <span class="mono threat-n">{String(i + 1).padStart(2, "0")}</span>
            <span class="threat-name">{t.name}</span>
            <span class="threat-tags">
              {t.tags.map((tag) => <span class:list={["tag", `tag-${tag}`]}>{tag}</span>)}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Get it -->
  <section class="section get-section">
    <div class="container">
      <div class="get-head">
        <h2>Stop typing commands. Start asking.</h2>
        <p class="section-lede">Free and open source. Pick how you want it.</p>
      </div>
      <div class="grid-3 get-grid">
        <a class="card get" href="/download#app">
          <h3>The app</h3>
          <p>A desktop window for JARVIS: chat, approvals, settings, providers. Linux, macOS and Windows.</p>
          <span class="get-more mono">Download →</span>
        </a>
        <a class="card get" href="/download#daemon">
          <h3>On the Linux you have</h3>
          <p>JARVIS itself, with its terminal UI, on the distribution you already run.</p>
          <span class="get-more mono">Install →</span>
        </a>
        <a class="card get" href="/download#jarvisos">
          <h3>JarvisOS</h3>
          <p>The whole system on Arch Linux and KDE Plasma 6, built from source with one pipeline.</p>
          <span class="get-more mono">Build it →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ heroAsks }}>
  const el = document.getElementById("ask-text");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms) => new Promise((r) => setTimeout(r, ms));

  async function cycle() {
    let i = 0;
    for (;;) {
      await wait(2600);
      const next = heroAsks[(i = (i + 1) % heroAsks.length)];
      if (still) {
        el.textContent = next;
        continue;
      }
      for (let n = el.textContent.length; n >= 0; n--) {
        el.textContent = el.textContent.slice(0, n);
        await wait(22);
      }
      for (let n = 1; n <= next.length; n++) {
        el.textContent = next.slice(0, n);
        await wait(55);
      }
    }
  }

  if (el) cycle();
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: calc(var(--space-3xl) + 1.5rem) 0 var(--space-3xl);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: -10% 0 auto;
    height: 900px;
    background: radial-gradient(closest-side, #00c8ff1f, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .hero h1 {
    font-size: clamp(3rem, 8.4vw, 6.2rem);
    line-height: 1;
    letter-spacing: -0.045em;
    margin-bottom: var(--space-xl);
  }

  .hl {
    color: var(--cyan);
  }

  .hero-sub {
    font-size: 1.25rem;
    line-height: 1.6;
    max-width: 40rem;
    margin: 0 auto var(--space-xl);
  }

  .aside {
    color: var(--text-muted);
    white-space: nowrap;
  }

  .ask-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: min(32rem, 100%);
    padding: 0.85rem 1.1rem;
    margin-bottom: var(--space-xl);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-card);
    box-shadow: 0 0 50px -18px #00c8ff55;
    text-align: left;
  }

  .ask-prompt {
    font-size: 0.72rem;
    color: #04121a;
    background: var(--cyan);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ask-text {
    font-size: 1.05rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .ask-caret {
    flex: none;
    width: 2px;
    height: 1.2em;
    margin-left: -0.5rem;
    background: var(--cyan);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    list-style: none;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .hero-facts li::before {
    content: "✓ ";
    color: var(--cyan);
  }

  .hero-visual {
    position: relative;
    max-width: 1040px;
    margin: var(--space-3xl) auto 0;
    padding-right: 4rem;
  }

  .hero-screen img {
    width: 100%;
    height: auto;
  }

  .hero-phone {
    position: absolute;
    width: 24%;
    max-width: 230px;
    right: 0;
    bottom: -2.5rem;
  }

  .hero-phone img {
    width: 100%;
    height: auto;
  }

  /* Why */
  .why-head {
    max-width: 46rem;
    margin-bottom: var(--space-2xl);
  }

  .why-head h2 {
    margin-bottom: var(--space-lg);
  }

  .why-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .why-who {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }

  .why-col .screen img {
    width: 100%;
    height: auto;
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
  }

  .bubble {
    max-width: 88%;
    padding: 0.8rem 1rem;
    border-radius: 14px;
    font-size: 0.97rem;
    line-height: 1.55;
  }

  .bubble--you {
    align-self: flex-end;
    background: #1b2633;
    color: var(--text-primary);
    border-bottom-right-radius: 4px;
  }

  .bubble--bot {
    align-self: flex-start;
    background: #121a24;
    color: var(--text-secondary);
    border-bottom-left-radius: 4px;
    display: grid;
    gap: 0.6rem;
  }

  .bubble--bot strong {
    color: var(--text-primary);
  }

  .cmd {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    background: #070a10;
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .chat-foot {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: var(--space-md);
  }

  .chat .chat-foot {
    margin-top: 0;
    color: var(--gold);
  }

  .why-col:last-child .chat-foot {
    color: var(--green);
  }

  /* Asks */
  .asks-section {
    overflow: hidden;
  }

  .asks-head {
    max-width: 44rem;
    margin-bottom: var(--space-2xl);
  }

  .marquee {
    display: grid;
    gap: var(--space-md);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: var(--space-md);
    width: max-content;
    list-style: none;
    animation: slide 70s linear infinite;
  }

  .marquee-row--reverse .marquee-track {
    animation-direction: reverse;
    animation-duration: 80s;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
