---
import BaseLayout from "../layouts/BaseLayout.astro";

const softwareSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JARVIS OS",
  operatingSystem: "Linux",
  applicationCategory: "OperatingSystem",
  description:
    "An AI assistant for Linux that finds and installs its own tools from a vetted MCP registry, asks before anything risky, runs local or cloud models, and can be driven from a phone over Tailscale. A research platform for LLM-OS security.",
  url: "https://jarvisoslinux.org",
  downloadUrl: "https://jarvisoslinux.org/download",
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  author: {
    "@type": "Organization",
    name: "JarvisOSLinux",
    url: "https://github.com/JarvisOSLinux",
  },
  keywords:
    "AI assistant, Linux, Model Context Protocol, MCP registry, LLM security, prompt injection, Arch Linux, llama.cpp",
});

const researchSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ResearchProject",
  name: "JARVIS OS — LLM-OS Security Research",
  description:
    "Empirical study of security threats that emerge when LLMs gain OS-level privileges. Produces the first threat taxonomy for AI-native operating systems.",
  url: "https://jarvisoslinux.org/research",
  funder: {
    "@type": "CollegeOrUniversity",
    name: "Washington State University Everett",
  },
  member: [
    { "@type": "Person", name: "Yakup Atahanov" },
    { "@type": "Person", name: "Toufic Majdalani" },
  ],
});

// A few of the registry's servers, as its manifests rate their tools.
const registry = [
  { name: "weather", what: "Forecasts and current conditions", level: "safe" },
  { name: "currency", what: "Exchange rates from the ECB", level: "safe" },
  { name: "news", what: "Headlines and topic search", level: "safe" },
  { name: "maps", what: "Places, nearby search, routes", level: "safe" },
  { name: "telegram", what: "Read and send as your bot", level: "dangerous" },
  { name: "jarvis-shell-system", what: "Commands as root, via polkit", level: "dangerous" },
];

const threats = [
  { name: "Malicious MCP Servers", tags: ["critical"] },
  { name: "Prompt Injection", tags: ["critical"] },
  { name: "Misleading MCP Server Usage", tags: ["high"] },
  { name: "Unauthorized Sudo Requests via MCP", tags: ["critical"] },
  { name: "Sudo Capability Exploitation", tags: ["critical"] },
  { name: "Bloated Context", tags: ["critical", "novel"] },
];
---

<BaseLayout
  fullTitle="JARVIS OS — An AI that runs your Linux machine, and asks first"
  description="JARVIS finds and installs its own tools from a vetted registry, does the work on your Linux machine, and waits for your OK before anything risky, on the laptop or your phone. Open source, built at WSU Everett."
>
  <script slot="head" type="application/ld+json" set:html={softwareSchema} />
  <script slot="head" type="application/ld+json" set:html={researchSchema} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow mono animate-fade-up">
          Open source <span>·</span> Linux <span>·</span> WSU Everett research
        </p>
        <h1 class="animate-fade-up animate-fade-up--delay-1">
          An AI that runs your Linux machine, and <span class="hl">asks before anything risky.</span>
        </h1>
        <p class="hero-sub animate-fade-up animate-fade-up--delay-2">
          Tell JARVIS what you want. It finds the tool it needs, installs it on the spot and does
          the work. Anything that could change your system waits for your OK, on the laptop or on
          your phone.
        </p>
        <div class="hero-actions animate-fade-up animate-fade-up--delay-3">
          <a href="/download" class="btn btn-primary">Get JARVIS</a>
          <a href="#safety" class="btn btn-outline">How it stays safe</a>
        </div>
        <ul class="hero-facts mono animate-fade-up animate-fade-up--delay-3">
          <li><strong>30+</strong> vetted tool servers</li>
          <li>Local or cloud models</li>
          <li>Phone control over Tailscale</li>
        </ul>
      </div>

      <div class="hero-visual" aria-label="JARVIS installing a package and waiting for approval">
        <figure class="screen hero-screen">
          <div class="screen-bar"><i></i><i></i><i></i><span>jarvis-app</span></div>
          <img
            src="/assets/screens/app-approval.webp"
            width="1600"
            height="1030"
            alt="The JARVIS app: asked to install cowsay, JARVIS found the root shell tool, started pacman as a job, and shows pacman asking to proceed while it waits for approval."
            fetchpriority="high"
          />
        </figure>
        <figure class="phone hero-phone">
          <img
            src="/assets/screens/phone-waiting.webp"
            width="640"
            height="1385"
            alt="The same request on a phone, with pacman's question in the job's output and one permission request waiting."
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- How a request goes -->
  <section class="section section--tight steps-section">
    <div class="container">
      <ol class="steps">
        <li>
          <span class="step-n mono">01</span>
          <h3>You ask</h3>
          <p>Type it in the app, the terminal or your phone, or say it out loud.</p>
        </li>
        <li>
          <span class="step-n mono">02</span>
          <h3>It finds the tool</h3>
          <p>JARVIS searches a vetted registry by meaning and installs only the server it needs.</p>
        </li>
        <li>
          <span class="step-n mono">03</span>
          <h3>You approve what matters</h3>
          <p>Reading and looking things up just run. Anything that changes your system waits for you.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Finds its own tools -->
  <section class="section feature">
    <div class="container feature-grid">
      <div class="feature-copy">
        <span class="section-label">Tools on demand</span>
        <h2>It finds its own tools, and only loads what it needs.</h2>
        <p class="section-lede">
          Many assistants load every tool you've connected into the model's prompt before you say
          a word. JARVIS starts with none. It searches the registry by meaning, reads the docs of
          the one server it picked and installs it, so even a small model stays focused.
        </p>
        <ul class="checks">
          <li>Every server is pinned to a commit. dmcp checks the manifest's SHA-256 at install and refuses a mismatch.</li>
          <li>Every tool has a reviewed threat level, and the confirmation gate reads it.</li>
          <li>Settings and keys go into a form, never the chat.</li>
        </ul>
      </div>
      <div class="registry card" aria-label="Some of the servers in the registry">
        <div class="registry-head">
          <span class="mono">mcp-registry</span>
          <span class="mono text-muted">30+ servers</span>
        </div>
        <ul>
          {registry.map((s) => (
            <li>
              <span class="reg-name mono">{s.name}</span>
              <span class="reg-what">{s.what}</span>
              <span class:list={["reg-level", "mono", `lvl-${s.level}`]}>{s.level}</span>
            </li>
          ))}
        </ul>
        <p class="registry-foot mono">+ GitHub, Microsoft 365, Notion, email, CalDAV, Discord, Home Assistant, Playwright…</p>
      </div>
    </div>
  </section>

  <!-- Asks first -->
  <section class="section feature section--band" id="safety">
    <div class="container feature-grid feature-grid--flip">
      <div class="feature-copy">
        <span class="section-label">Safety, in code</span>
        <h2>It asks before anything risky.</h2>
        <p class="section-lede">
          Models don't reliably follow rules in a prompt, so JARVIS doesn't rely on them. Every
          tool call goes through a gate before it runs.
        </p>
        <dl class="tiers">
          <div><dt class="lvl-safe mono">safe</dt><dd>Runs. Reading, searching, looking things up.</dd></div>
          <div><dt class="lvl-elevated mono">elevated</dt><dd>Waits for you. Signing in, reading private data.</dd></div>
          <div><dt class="lvl-dangerous mono">dangerous</dt><dd>Waits for you. Sending, deleting, running commands.</dd></div>
          <div><dt class="lvl-forbidden mono">forbidden</dt><dd>Refused, even with approvals turned off.</dd></div>
        </dl>
        <p class="fine">
          Tool output is wrapped in a per-task random boundary, so a web page or a file can't pass
          itself off as an instruction.
        </p>
      </div>
      <div class="feature-visual feature-visual--phone">
        <figure class="phone">
          <img
            src="/assets/screens/phone-waiting.webp"
            width="640"
            height="1385"
            loading="lazy"
            alt="JARVIS on a phone, waiting: pacman asks to proceed and the request is held."
          />
        </figure>
        <img
          class="approval-card"
          src="/assets/screens/approval-card.webp"
          width="760"
          height="266"
          loading="lazy"
          alt="The permission card: answer pacman's question with Y, Approve or Deny."
        />
      </div>
    </div>
  </section>

  <!-- Root -->
  <section class="section feature">
    <div class="container feature-grid">
      <div class="feature-copy">
        <span class="section-label">Root access</span>
        <h2>Root, without handing over root.</h2>
        <p class="section-lede">
          Commands that need root go to a separate server, and polkit starts it only with your
          password. JARVIS never holds root itself.
        </p>
        <ul class="checks">
          <li>A <code>sudo</code> the model adds is removed, and root commands go one at a time.</li>
          <li>A package install becomes a job, so pacman's <code>[Y/n]</code> comes to you.</li>
          <li>Stop ends JARVIS's turn but leaves a running update alone. Killing one takes a second press.</li>
        </ul>
      </div>
      <figure class="screen feature-visual">
        <div class="screen-bar"><i></i><i></i><i></i><span>jarvis-app</span></div>
        <img
          src="/assets/screens/app-done.webp"
          width="1600"
          height="1030"
          loading="lazy"
          alt="The finished request: the search, the pacman job, the approved answer to its question, and JARVIS saying cowsay is installed."
        />
      </figure>
    </div>
  </section>

  <!-- More -->
  <section class="section section--tight">
    <div class="container">
      <div class="more-grid">
        <div class="more">
          <h3>From your phone</h3>
          <p>
            <code>jarvis web</code> serves the app to your phone over Tailscale, never the open
            internet. Each person gets a role, every change is logged, and your API keys never
            reach the phone.
          </p>
        </div>
        <div class="more">
          <h3>Any model, local or cloud</h3>
          <p>
            Run a GGUF model on your machine with llama.cpp, or use any OpenAI-compatible API.
            If one provider fails, JARVIS moves to the next, and you can change them without a
            restart.
          </p>
        </div>
        <div class="more">
          <h3>Shows its work</h3>
          <p>
            Every search, install and command is a block you can open, with its live output.
            You can see what's running and stop any of it.
          </p>
        </div>
        <div class="more">
          <h3>Voice</h3>
          <p>
            A wake word and offline speech: Vosk or faster-whisper to listen, Piper to answer.
            JARVIS can also say what it's about to do before it does it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Research -->
  <section class="section section--band research-band">
    <div class="container research-grid">
      <div>
        <span class="section-label">Research</span>
        <h2>Built to study what goes wrong.</h2>
        <p class="section-lede">
          JARVIS is also a research platform. We gave a language model operating-system privileges
          and catalogued how that fails. The result is the first empirical threat taxonomy for
          LLM-OS integration, and each mitigation on this page answers one of its threats.
        </p>
        <p class="award mono">SURCA 2026 · Winner, Gray Grant</p>
        <a href="/research" class="btn btn-outline">Read the research</a>
      </div>
      <ol class="threat-list">
        {threats.map((t, i) => (
          <li>
            <span class="mono threat-n">{String(i + 1).padStart(2, "0")}</span>
            <span class="threat-name">{t.name}</span>
            <span class="threat-tags">
              {t.tags.map((tag) => <span class:list={["tag", `tag-${tag}`]}>{tag}</span>)}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Get it -->
  <section class="section">
    <div class="container">
      <span class="section-label">Get JARVIS</span>
      <h2 class="section-title">Three ways in.</h2>
      <div class="grid-3 get-grid">
        <a class="card get" href="/download#app">
          <h3>The app</h3>
          <p>A desktop window for JARVIS: chat, approvals, settings, providers. Linux, macOS and Windows.</p>
          <span class="get-more mono">Download →</span>
        </a>
        <a class="card get" href="/download#daemon">
          <h3>The daemon</h3>
          <p>JARVIS itself, with its terminal UI, on the Linux you already run.</p>
          <span class="get-more mono">Install →</span>
        </a>
        <a class="card get" href="/download#jarvisos">
          <h3>JarvisOS</h3>
          <p>The whole system on Arch Linux and KDE Plasma 6, built from source with one pipeline.</p>
          <span class="get-more mono">Build it →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: calc(var(--space-3xl) + 1rem) 0 var(--space-3xl);
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: -20% -10% auto 30%;
    height: 900px;
    background: radial-gradient(closest-side, #00c8ff1f, transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }

  .hero-eyebrow span {
    color: var(--text-muted);
    margin: 0 0.35em;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    margin-bottom: var(--space-lg);
  }

  .hl {
    color: var(--cyan);
  }

  .hero-sub {
    font-size: 1.2rem;
    line-height: 1.65;
    max-width: 34rem;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .hero-facts strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  .hero-visual {
    position: relative;
    padding-bottom: 3rem;
  }

  .hero-screen img {
    width: 100%;
    height: auto;
  }

  .hero-phone {
    position: absolute;
    width: 32%;
    max-width: 210px;
    right: -1.5rem;
    bottom: -0.5rem;
  }

  .hero-phone img {
    width: 100%;
    height: auto;
  }

  /* Steps */
  .steps-section {
    border-top: 1px solid var(--border-subtle);
  }

  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .step-n {
    display: block;
    font-size: 0.8rem;
    color: var(--cyan);
    margin-bottom: var(--space-sm);
  }

  .steps h3 {
    margin-bottom: var(--space-xs);
  }

  .steps p {
    font-size: 0.97rem;
  }

  /* Feature rows */
  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .feature-grid--flip .feature-copy {
    order: 2;
  }

  .feature h2 {
    margin-bottom: var(--space-lg);
    max-width: 18ch;
  }

  .feature .section-lede {
    margin-bottom: var(--space-xl);
  }

  .checks {
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  .checks li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .checks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    border: 1.5px solid var(--cyan);
    background: radial-gradient(circle, var(--cyan) 0 30%, transparent 34%);
  }

  .feature-visual img {
    width: 100%;
    height: auto;
  }

  .feature-visual--phone {
    position: relative;
    display: flex;
    justify-content: center;
    padding: var(--space-xl) 0;
  }

  .approval-card {
    position: absolute;
    width: min(330px, 70%);
    left: 0;
    bottom: 22%;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    box-shadow: 0 30px 60px -20px #000000f0, 0 0 40px -10px #00c8ff40;
  }

  .feature-visual--phone .phone {
    width: min(300px, 80%);
  }

  .feature-visual--phone .phone img {
    width: 100%;
    height: auto;
  }

  /* Registry card */
  .registry {
    padding: 0;
  }

  .registry-head {
    display: flex;
    justify-content: space-between;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
  }

  .registry ul {
    list-style: none;
  }

  .registry li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) auto;
    gap: var(--space-md);
    align-items: center;
    padding: 0.85rem var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
  }

  .reg-name {
    font-size: 0.85rem;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reg-what {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .reg-level {
    font-size: 0.72rem;
  }

  .registry-foot {
    padding: var(--space-md) var(--space-lg);
    font-size: 0.75rem;
    color: var(--text-muted);
    max-width: none;
  }

  .lvl-safe { color: var(--green); }
  .lvl-elevated { color: var(--cyan); }
  .lvl-dangerous { color: var(--gold); }
  .lvl-forbidden { color: var(--red); }

  /* Tiers */
  .tiers {
    display: grid;
    gap: 0;
    margin-bottom: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .tiers div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-md);
    padding: 0.8rem var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-card);
  }

  .tiers div:last-child {
    border-bottom: none;
  }

  .tiers dt {
    font-size: 0.8rem;
    padding-top: 0.15rem;
  }

  .tiers dd {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .fine {
    font-size: 0.95rem;
  }

  /* More */
  .more-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2xl);
  }

  .more h3 {
    margin-bottom: var(--space-sm);
  }

  .more p {
    font-size: 0.95rem;
  }

  /* Research */
  .research-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .research-grid h2 {
    margin-bottom: var(--space-lg);
  }

  .research-grid .section-lede {
    margin-bottom: var(--space-lg);
  }

  .award {
    font-size: 0.8rem;
    color: var(--gold);
    margin-bottom: var(--space-xl);
  }

  .threat-list {
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .threat-list li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    gap: var(--space-md);
    align-items: center;
    padding: 0.95rem var(--space-lg);
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-subtle);
  }

  .threat-list li:last-child {
    border-bottom: none;
  }

  .threat-n {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .threat-name {
    font-weight: 500;
  }

  .threat-tags {
    display: flex;
    gap: 0.4rem;
  }

  /* Get */
  .get {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    color: inherit;
  }

  .get p {
    flex: 1;
  }

  .get-more {
    font-size: 0.82rem;
    color: var(--cyan);
    margin-top: var(--space-md);
  }

  .get:hover {
    color: inherit;
  }

  @media (max-width: 1080px) {
    .more-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .hero-grid,
    .feature-grid,
    .research-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xl);
    }

    .feature-grid--flip .feature-copy {
      order: 0;
    }

    .hero-phone {
      right: 0.5rem;
      width: 30%;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: var(--space-2xl);
    }

    .hero-sub {
      font-size: 1.08rem;
    }

    .steps,
    .more-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .registry li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .reg-what {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 0.85rem;
      margin-top: -0.4rem;
    }

    .tiers div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>
