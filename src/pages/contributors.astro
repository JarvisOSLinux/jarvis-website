---
import BaseLayout from "../layouts/BaseLayout.astro";
import { github } from "../lib/github";

const REPOS = ["Project-JARVIS", "dispatch", "dmcp", "contextor", "mcp-registry", "jarvisos", "jarvis-app", "linux-jarvisos", "jarvis-website"];

const counts = new Map<string, { login: string; avatar: string; url: string; count: number }>();
for (const data of await Promise.all(
  REPOS.map((repo) => github(`repos/JarvisOSLinux/${repo}/contributors?per_page=50`))
)) {
  for (const c of data ?? []) {
    if (c.type !== "User") continue;
    const existing = counts.get(c.login);
    if (existing) existing.count += c.contributions;
    else counts.set(c.login, { login: c.login, avatar: c.avatar_url, url: c.html_url, count: c.contributions });
  }
}
const sorted = [...counts.values()].sort((a, b) => b.count - a.count);

// Avatars are inlined so the page loads nothing from GitHub; a failed one is left out.
async function avatar(url: string): Promise<string | null> {
  try {
    const sized = new URL(url);
    sized.searchParams.set("s", "128");
    const res = await fetch(sized, { signal: AbortSignal.timeout(10_000) });
    const type = res.headers.get("content-type") ?? "";
    if (!res.ok || !type.startsWith("image/")) return null;
    return `data:${type};base64,${Buffer.from(await res.arrayBuffer()).toString("base64")}`;
  } catch {
    return null;
  }
}
const contributors = await Promise.all(
  sorted.map(async (c) => ({ ...c, avatar: await avatar(c.avatar) }))
);
---

<BaseLayout
  title="Contributors"
  description="JARVIS OS research team — Yakup Atahanov and Toufic Majdalani (WSU Everett), plus open-source contributors. SURCA 2026 Gray Grant recipients."
>
  <section class="section">
    <div class="container">
      <span class="section-label">Team</span>
      <h1 class="section-title">Contributors</h1>
      <p class="contrib-intro">
        JARVIS OS is a research project at Washington State University — Everett,
        funded by a WSU research grant.
      </p>
    </div>
  </section>

  <!-- Core Team -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <h2 style="margin-bottom: var(--space-xl);">Core Team</h2>
      <div class="grid-2">
        <div class="card team-card">
          <h3>Yakup Atahanov</h3>
          <p class="mono text-cyan" style="font-size: 0.8rem; margin-bottom: var(--space-sm);">
            Lead Developer &amp; Researcher
          </p>
          <p>
            Lead author of the research paper and architect of the Project-JARVIS
            system — the AI daemon, dispatch, dmcp, contextor, and mcp-registry.
            Co-author of the threat taxonomy. Designed the security analysis framework.
          </p>
          <a
            href="https://github.com/YakupAtahanov"
            class="team-link mono"
            target="_blank"
            rel="noopener noreferrer"
          >
            @YakupAtahanov
          </a>
        </div>
        <div class="card team-card">
          <h3>Toufic Majdalani</h3>
          <p class="mono text-cyan" style="font-size: 0.8rem; margin-bottom: var(--space-sm);">
            Co-Author &amp; Researcher
          </p>
          <p>
            Co-author of the research paper and the threat taxonomy. Architect of
            JarvisOS — the Linux distribution implementation, build pipeline, custom
            kernel, and installer. Collaborated on the SURCA presentation and
            academic methodology.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- GitHub Contributors -->
  <section class="section">
    <div class="container">
      <h2 style="margin-bottom: var(--space-xl);">GitHub Contributors</h2>
      <p style="margin-bottom: var(--space-lg);">
        Contributors across all repositories in the{" "}
        <a href="https://github.com/JarvisOSLinux" target="_blank" rel="noopener noreferrer">jarvisos</a>
        organization, read from the GitHub API when this page was built.
      </p>
      <div class="grid-4">
        {contributors.length > 0 ? (
          contributors.map((c) => (
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="card contrib-card">
              {c.avatar && <img src={c.avatar} alt={c.login} width="64" height="64" class="contrib-avatar" />}
              <span class="contrib-name">@{c.login}</span>
              <span class="contrib-count">{c.count} contributions</span>
            </a>
          ))
        ) : (
          <div class="card" style="grid-column: 1 / -1; text-align: center;">
            <p class="mono text-muted">
              Could not load contributors when this page was built.{" "}
              <a href="https://github.com/orgs/JarvisOSLinux/people">View on GitHub</a>
            </p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contrib-intro {
    font-size: 1.05rem;
    max-width: 640px;
  }

  .team-card {
    display: flex;
    flex-direction: column;
  }

  .team-link {
    margin-top: auto;
    padding-top: var(--space-md);
    font-size: 0.85rem;
  }

  .contrib-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-lg);
  }

  .contrib-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid var(--border);
    margin-bottom: var(--space-md);
  }

  .contrib-name {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-primary);
  }

  .contrib-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: var(--space-xs);
  }
</style>
